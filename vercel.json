{
  "functions": {
    "api/index.py": {
      "runtime": "vercel-python@0.1.0"
    }
  },
  "routes": [
    {
      "src": "/admin-login",
      "dest": "/api/index.py"
    },
    {
      "src": "/admin-dashboard",
      "dest": "/api/index.py"
    },
    {
      "src": "/admin-logout",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)\\.html",
      "dest": "/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}